model Post {
  /// @zod.uuid("Invalid UUID")
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  editedAt  DateTime? @map("edited_at")

  /// @zod.min(1, "Content must be at least 1 character long").max(5000, "Content must be at most 5000 characters long")
  content String

  isSpoiler Boolean @default(false) @map("is_spoiler")

  /// Members can like the post.
  allowLikes    Boolean @default(true) @map("allow_likes")
  /// Members can comment on the post.
  allowComments Boolean @default(true) @map("allow_comments")
  /// Members can share the post inside their own posts (links still work anywhere).
  allowShares   Boolean @default(true) @map("allow_shares")

  /// Public R2 URL for optional post image.
  /// @zod.max(2048).nullish()
  imageUrl String? @map("image_url")

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String @unique

  /// @zod.uuid("Invalid user id")
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid book id")
  attachedBookId String? @map("attached_book_id")
  attachedBook   Book?   @relation(fields: [attachedBookId], references: [id], onDelete: SetNull)

  attachment          PostAttachment?
  poll                PostPoll?
  quotedInAttachments PostAttachment[] @relation("QuotedPostAttachment")
  mentions            ContentMention[]

  likes    Like[]
  comments Comment[]

  @@index([authorId])
  @@index([slug])
  @@map("post")
}

enum PostAttachmentKind {
  book
  shelf
  sitting
  user
  feedback
  post
  comment
  author
}

model PostAttachment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// @zod.uuid("Invalid post id")
  postId String @unique @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  kind PostAttachmentKind

  /// @zod.uuid("Invalid book id")
  bookId String? @map("book_id")
  book   Book?   @relation(fields: [bookId], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid shelf id")
  shelfId String? @map("shelf_id")
  shelf   Shelf?  @relation(fields: [shelfId], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid sitting id")
  sittingId String?  @map("sitting_id")
  sitting   Sitting? @relation(fields: [sittingId], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid user id")
  memberId String? @map("member_id")
  member   User?   @relation("PostAttachmentMember", fields: [memberId], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid feedback id")
  feedbackId String?   @map("feedback_id")
  feedback   Feedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid post id")
  attachedPostId String? @map("attached_post_id")
  attachedPost   Post?   @relation("QuotedPostAttachment", fields: [attachedPostId], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid comment id")
  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  /// Authors have no table of their own: the slug and the name at the time it was attached.
  authorSlug String? @map("author_slug")
  authorName String? @map("author_name")

  @@index([kind])
  @@map("post_attachment")
}

enum LikeSource {
  post
  comment
  feedback
}

model Like {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source LikeSource

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid post id")
  postId String? @map("post_id")
  post   Post?   @relation(fields: [postId], references: [id])

  /// @zod.uuid("Invalid comment id")
  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id])

  /// @zod.uuid("Invalid feedback id")
  feedbackId String?   @map("feedback_id")
  feedback   Feedback? @relation(fields: [feedbackId], references: [id])

  @@index([userId])
  @@index([postId])
  @@index([commentId])
  @@index([feedbackId])
  @@map("like")
}

model Comment {
  /// @zod.uuid("Invalid UUID")
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  editedAt  DateTime? @map("edited_at")

  /// @zod.min(1, "Content must be at least 1 character long").max(5000, "Content must be at most 5000 characters long")
  content String

  isSpoiler Boolean @default(false) @map("is_spoiler")

  /// Public R2 URL for optional comment image.
  /// @zod.max(2048).nullish()
  imageUrl String? @map("image_url")

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String @unique

  /// @zod.uuid("Invalid user id")
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid post id")
  postId String? @map("post_id")
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid feedback id")
  feedbackId String?   @map("feedback_id")
  feedback   Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid parent comment id")
  parentId String?   @map("parent_id")
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  /// @zod.int().min(0).max(4)
  depth Int @default(0)

  likes           Like[]
  postAttachments PostAttachment[]
  mentions        ContentMention[]

  @@index([authorId])
  @@index([postId])
  @@index([postId, parentId])
  @@index([feedbackId])
  @@index([feedbackId, parentId])
  @@index([slug])
  @@map("comment")
}

/// A member mentioned (`@Name`) in a post, a comment or a review. The text itself holds the
/// mention; this row makes it cheap to notify once, to diff an edit and to list "where I was mentioned".
/// Exactly one of postId / commentId / feedbackId is set.
model ContentMention {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  mentionedUserId String @map("mentioned_user_id")
  mentionedUser   User   @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation("MentionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  postId String? @map("post_id")
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  feedbackId String?   @map("feedback_id")
  feedback   Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([mentionedUserId, postId])
  @@unique([mentionedUserId, commentId])
  @@unique([mentionedUserId, feedbackId])
  @@index([mentionedUserId, createdAt])
  @@index([postId])
  @@index([commentId])
  @@index([feedbackId])
  @@map("content_mention")
}

/// What we learned from an outside page when it was linked (title, description, a small copy of its image).
/// `failed` rows are kept for a while so a broken site is not asked again and again.
model LinkPreviewCache {
  /// sha256 of the normalised address.
  urlHash     String   @id @map("url_hash")
  url         String
  status      String   @default("ok")
  title       String?
  description String?
  siteName    String?  @map("site_name")
  /// Our copy of the picture (small WebP in our storage), never the other site's address.
  imageUrl    String?  @map("image_url")
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("link_preview_cache")
}
