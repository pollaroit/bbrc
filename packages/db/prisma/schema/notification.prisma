enum NotificationKind {
  member_posted
  comment_on_your_post
  reply_to_your_comment
  reaction_on_your_post
  member_feedback_on_book
  book_added_to_library
  sitting_poll_started
  sitting_poll_closed
  participant_finished_book
  sitting_finished
  book_requested
  document_submitted
  document_approved
  document_rejected
  achievement_earned
  shelf_invitation
  shelf_collaboration
  poll_vote
  poll_ended
}

model Notification {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// @zod.min(1).max(120)
  title String
  /// @zod.min(1).max(500)
  body  String
  /// @zod.max(500)
  href  String?

  readAt DateTime? @map("read_at")

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notification")
}

model NotificationPreference {
  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  inAppEnabled Boolean @default(true) @map("in_app_enabled")
  pushEnabled  Boolean @default(false) @map("push_enabled")

  @@id([userId, kind])
  @@map("notification_preference")
}
