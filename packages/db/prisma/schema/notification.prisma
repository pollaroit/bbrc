enum NotificationKind {
  member_posted
  comment_on_your_post
  reply_to_your_comment
  reaction_on_your_post
  member_feedback_on_book
  book_added_to_library
  sitting_poll_started
  sitting_poll_closed
  participant_finished_book
  sitting_finished
  book_requested
  document_submitted
  document_approved
  document_rejected
  achievement_earned
  shelf_invitation
  shelf_collaboration
  poll_vote
  poll_ended
  sitting_member_joined
  sitting_invitation
  sitting_added
  sitting_welcome
  view_milestone
  views_digest
  reading_behind
  mention
  author_new_book
  sitting_opened
  sitting_midterm_checkin
  sitting_deadline_24h
  sitting_reading_reminder
}

model Notification {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// @zod.min(1).max(120)
  title String
  /// @zod.min(1).max(500)
  body  String
  /// @zod.max(500)
  href  String?

  readAt DateTime? @map("read_at")

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notification")
}

model NotificationPreference {
  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  inAppEnabled Boolean @default(true) @map("in_app_enabled")
  pushEnabled  Boolean @default(false) @map("push_enabled")

  @@id([userId, kind])
  @@map("notification_preference")
}

/// A browser or installed app that receives this member's push notifications (registered with Ably Push).
/// Ably holds the registration; this row gives it a name for the settings page and ties it to the member.
model PushDevice {
  /// @zod.uuid("Invalid UUID")
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Ably's id for the device.
  deviceId String @unique @map("device_id")
  /// What the member sees in their device list, for example "Chrome on macOS".
  label    String

  @@index([userId])
  @@map("push_device")
}
