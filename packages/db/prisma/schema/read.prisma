/// Per-member “has read this book” (no in-progress state — row exists or it does not).
model Read {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid book id")
  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// Finish month (both null = unknown). Month is calendar 1–12.
  /// @zod.min(1).max(12)
  readEndMonth Int? @map("read_end_month")
  /// @zod.min(1000).max(2100)
  readEndYear  Int? @map("read_end_year")

  /// Open Library edition OLID (e.g. `OL123456M`), optional.
  /// @zod.import(["import { isOpenLibraryEditionOlid } from '@bbrc/shared'"])
  /// @zod.refine((v) => v == null || isOpenLibraryEditionOlid(v), { message: "Invalid Open Library edition ID" })
  editionId String? @map("edition_id")

  @@id([userId, bookId])
  @@index([bookId])
  @@index([userId])
  @@index([userId, readEndYear, readEndMonth])
  @@index([editionId])
  @@map("member_read")
}
