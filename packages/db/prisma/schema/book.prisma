enum BookStatus {
  completed
  reading
  wishlist
}

/// Where a catalog book came from. Open Library books carry a work id (`olid`);
/// manual books were typed in by an admin and have none.
enum BookSource {
  open_library
  manual
}

model Book {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.min(2, "Title must be at least 2 characters long").max(255, "Title must be at most 255 characters long")
  title String

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String @unique

  /// @zod.min(1, "At least one author is required")
  authors           String[]
  /// @zod.min(1, "At least one page is required")
  pages             Int
  status            BookStatus @default(wishlist)
  /// @zod.min(0, "Open Library rating must be a non-negative number").max(5, "Open Library rating must be at most 5").nullish()
  openLibraryRating Float?     @map("open_library_rating")
  /// @zod.min(0, "Published in must be a non-negative number").refine((v) => v <= new Date().getFullYear(), { message: "Published in must be in the past" })
  publishedIn       Int        @map("published_in")
  /// @zod.min(0, "Average rating must be a non-negative number").max(5, "Average rating must be at most 5")
  averageRating     Float?     @map("average_rating")
  coverId           Int?       @map("cover_id")
  /// A cover uploaded by an admin (public R2 URL, fixed 2:3). Wins over `coverId`.
  /// @zod.max(2048).nullish()
  customCoverUrl    String?    @map("custom_cover_url")
  /// @zod.max(4000, "Excerpt must be at most 4000 characters long").nullish()
  excerpt           String?    @db.Text

  /// Null for manual books (see `source`). A unique index allows many nulls.
  /// @zod.import(["import { isOpenLibraryOlid } from '@bbrc/shared'"])
  /// @zod.refine((v) => isOpenLibraryOlid(v), { message: "Invalid Open Library work ID" })
  olid   String?    @unique
  source BookSource @default(open_library) @map("source")

  /// Never offered to a sitting (poll draws, shuffles, replacements, the organiser's picker).
  /// Everything else about the book works as usual. Set by admins only.
  hidden Boolean @default(false)

  /// Manual books only: the edition that supplies `pages` and the cover. Set when the book is created.
  primaryEditionId String?      @unique @map("primary_edition_id")
  primaryEdition   BookEdition? @relation("BookPrimaryEdition", fields: [primaryEditionId], references: [id], onDelete: SetNull)

  /// Copy of the opens total (see `ViewTotal`), kept here so lists can sort by it.
  viewCount   Int @default(0) @map("view_count")
  /// Copy of the distinct people who opened it, for sorting.
  viewerCount Int @default(0) @map("viewer_count")

  /// Members reading it right now (visible members only); a copy kept so lists can sort by it.
  readingNowCount Int @default(0) @map("reading_now_count")
  /// Members with it on their wishlist (visible members only); a copy kept so lists can sort by it.
  wishlistCount   Int @default(0) @map("wishlist_count")

  subjectPeople String[] @default([]) @map("subject_people")
  subjectTimes  String[] @default([]) @map("subject_times")
  subjects      String[] @default([])
  /// Literary origin: modern sovereign states (ISO 3166-1 alpha-2), not story setting.
  countries     String[] @default([])

  feedbacks           Feedback[]
  readings            Reading[]
  authorLinks         BookAuthor[]
  editions            BookEdition[]       @relation("BookEditions")
  editionTombstones   EditionTombstone[]
  editionSnapshots    EditionSnapshot[]
  polls               PollOption[]
  posts               Post[]
  postAttachments     PostAttachment[]
  favorites           Favorite[]
  shelfBooks          ShelfBook[]
  pollOptions         PostPollOption[]
  tierlistItems       PostTierlistItem[]
  sittingsSelectedFor Sitting[]           @relation("SittingSelectedBook")
  documents           Document[]
  reads               Read[]
  quiz                Quiz?
  quizGenerationLogs  QuizGenerationLog[]

  readAfterPrerequisites BookReadingPrerequisite[] @relation("BookReadAfter")
  prerequisiteForBooks   BookReadingPrerequisite[] @relation("BookPrerequisiteFor")
  seriesMembership       SeriesBook?

  /// @zod.uuid("Invalid UUID")
  requestedById String? @map("requested_by_id")
  requestedBy   User?   @relation("BookRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid UUID")
  approvedById String? @map("approved_by_id")
  approvedBy   User?   @relation("BookApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([title])
  @@index([pages])
  @@index([status])
  @@index([hidden])
  @@index([authors])
  @@map("book")
}
