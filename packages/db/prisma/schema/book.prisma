enum BookStatus {
  completed
  reading
  wishlist
}

model Book {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.min(2, "Title must be at least 2 characters long").max(255, "Title must be at most 255 characters long")
  title String

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String @unique

  /// @zod.min(1, "At least one author is required")
  authors         String[]
  /// @zod.min(1, "At least one page is required")
  pages           Int
  status          BookStatus @default(wishlist)
  /// @zod.min(0, "Open Library rating must be a non-negative number").max(5, "Open Library rating must be at most 5").nullish()
  openLibraryRating Float?     @map("open_library_rating")
  /// @zod.min(0, "Published in must be a non-negative number").refine((v) => v <= new Date().getFullYear(), { message: "Published in must be in the past" })
  publishedIn     Int        @map("published_in")
  /// @zod.min(0, "Average rating must be a non-negative number").max(5, "Average rating must be at most 5")
  averageRating   Float?     @map("average_rating")
  coverId         Int?       @map("cover_id")
  /// @zod.max(4000, "Excerpt must be at most 4000 characters long").nullish()
  excerpt         String?    @db.Text

  /// @zod.import(["import { isOpenLibraryOlid } from '@bbrc/shared'"])
  /// @zod.refine((v) => isOpenLibraryOlid(v), { message: "Invalid Open Library work ID" })
  olid            String     @unique

  subjectPeople String[] @default([]) @map("subject_people")
  subjectTimes  String[] @default([]) @map("subject_times")
  subjects      String[] @default([])

  feedbacks Feedback[]
  polls     PollOption[]
  posts            Post[]
  postAttachments  PostAttachment[]
  favorites Favorite[]
  shelfBooks ShelfBook[]
  sittingsSelectedFor Sitting[] @relation("SittingSelectedBook")
  documents           Document[]

  /// @zod.uuid("Invalid UUID")
  requestedById String? @map("requested_by_id")
  requestedBy   User?   @relation("BookRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid UUID")
  approvedById String? @map("approved_by_id")
  approvedBy   User?   @relation("BookApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([title])
  @@index([pages])
  @@index([status])
  @@index([authors])
  @@map("book")
}
