/// Who can see a shelf (on top of its status): everyone, the owner's friends, or only the owner and collaborators.
/// The order of the levels lives in `packages/shared/src/visibility`.
enum ShelfVisibility {
  public
  friends
  private

  @@map("shelf_visibility")
}

enum ShelfStatus {
  draft
  active
  archived
}

enum ShelfType {
  /// Shows rank numbers (1, 2, 3…) on the public shelf page.
  ordered
  /// Same drag order internally; public view hides rank numbers.
  unordered
}

enum ShelfPermission {
  add_book
  remove_book
  edit_notes
  edit_title
  edit_description
  edit_cover
  edit_type
  edit_status
  edit_ordering_on_simple
  edit_ordering_on_ranked
  view_non_public
  delete_shelf
  add_collaborator
  remove_collaborator
  edit_permissions
}

enum ShelfInvitationStatus {
  pending
  accepted
  rejected
  cancelled
}

enum ShelfActivityKind {
  book_added
  book_removed
  books_reordered
  notes_edited
  shelf_updated
  collaborator_joined
  collaborator_left
  collaborator_removed
  permissions_changed
  ownership_transferred
}

model Shelf {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String

  /// @zod.min(1, "Title is required").max(120, "Title must be at most 120 characters long")
  title String

  /// @zod.max(2000, "Description must be at most 2000 characters long").nullish()
  description String? @db.Text

  /// Optional cover override (public R2 URL). When null, UI uses book-grid mosaic.
  /// @zod.max(2048).nullish()
  coverImageUrl String? @map("cover_image_url")

  status ShelfStatus @default(draft)
  type   ShelfType   @default(unordered)

  visibility ShelfVisibility @default(public)
  /// Each member's special Wishlist shelf (one per member, cannot be deleted or reshaped).
  isWishlist Boolean         @default(false) @map("is_wishlist")

  /// Copy of the opens total (see `ViewTotal`), kept here so lists can sort by it.
  viewCount   Int @default(0) @map("view_count")
  /// Copy of the distinct people who opened it, for sorting.
  viewerCount Int @default(0) @map("viewer_count")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  books           ShelfBook[]
  postAttachments PostAttachment[]
  collaborators   ShelfCollaborator[]
  invitations     ShelfInvitation[]
  activities      ShelfActivity[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([visibility, status])
  @@map("shelf")
}

model ShelfBook {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.uuid("Invalid shelf id")
  shelfId String @map("shelf_id")
  shelf   Shelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid book id")
  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// Dense 0-based order within the shelf (both ordered and unordered types).
  position Int

  /// @zod.max(500, "Notes must be at most 500 characters long").nullish()
  notes String? @db.Text

  /// Who put the book on the shelf (null only if that member was deleted).
  addedById String? @map("added_by_id")
  addedBy   User?   @relation("ShelfBookAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  /// Who last changed this entry (added it, edited its notes or moved it).
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("ShelfBookUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([shelfId, bookId])
  @@unique([shelfId, position])
  @@index([bookId])
  @@index([shelfId, position])
  @@map("shelf_book")
}

/// A member who can help edit someone else's shelf. The owner is never a row here.
model ShelfCollaborator {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shelfId String @map("shelf_id")
  shelf   Shelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("ShelfCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)

  permissions ShelfPermission[]

  invitedById String? @map("invited_by_id")
  invitedBy   User?   @relation("ShelfCollaboratorInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([shelfId, userId])
  @@index([userId])
  @@map("shelf_collaborator")
}

model ShelfInvitation {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shelfId String @map("shelf_id")
  shelf   Shelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)

  inviteeId String @map("invitee_id")
  invitee   User   @relation("ShelfInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  invitedById String @map("invited_by_id")
  invitedBy   User   @relation("ShelfInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  permissions ShelfPermission[]
  status      ShelfInvitationStatus @default(pending)

  /// Secret in the invitation link; only the invitee's signed-in account can use it.
  token String @unique

  expiresAt   DateTime  @map("expires_at")
  respondedAt DateTime? @map("responded_at")

  @@index([shelfId, status])
  @@index([inviteeId, status])
  @@map("shelf_invitation")
}

/// What collaborators did on a shelf; shown to people who manage it.
model ShelfActivity {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  shelfId String @map("shelf_id")
  shelf   Shelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)

  actorId String? @map("actor_id")
  actor   User?   @relation("ShelfActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  kind ShelfActivityKind

  targetUserId String? @map("target_user_id")
  targetUser   User?   @relation("ShelfActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  /// Book title and slug, counts, or permission names; kept so the log still reads after a book is removed.
  meta Json?

  @@index([shelfId, createdAt])
  @@map("shelf_activity")
}
