enum UserStatus {
  active
  warned
  banned
}

model User {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.min(3, "Name must be at least 3 characters long").max(30, "Name must be at most 30 characters long")
  name                  String
  /// @zod.import(["import { isUsername } from '@bbrc/shared'"])
  /// @zod.min(3, "Username must be at least 3 characters long").max(20, "Username must be at most 20 characters long").refine((v) => isUsername(v), { message: "Invalid username" })
  username              String     @unique
  /// Set when the member last changed `username` (self-service); null until first change.
  usernameLastUpdatedAt DateTime?  @map("username_last_updated_at")
  /// New reads start with the current month and year filled in.
  readDateDefaultsToNow Boolean    @default(true) @map("read_date_defaults_to_now")
  /// Other members may invite this member to collaborate on their shelves.
  allowShelfInvites     Boolean    @default(true) @map("allow_shelf_invites")
  /// Other members may use this member as an option in their polls.
  allowPollOptions      Boolean    @default(true) @map("allow_poll_options")
  /// Other members may attach this member to their posts.
  allowPostAttachment   Boolean    @default(true) @map("allow_post_attachment")
  /// Organisers may add this member to a sitting without asking.
  allowSittingAutoAdd   Boolean    @default(true) @map("allow_sitting_auto_add")
  /// Others can see which books this member is reading right now.
  /// Others can mention this member (the picker only offers members who allow it; existing mentions stay).
  allowMentions         Boolean    @default(true) @map("allow_mentions")
  showCurrentlyReading  Boolean    @default(true) @map("show_currently_reading")
  /// Others can see how far along this member is (otherwise just "reading").
  showReadingProgress   Boolean    @default(true) @map("show_reading_progress")
  /// Organisers may send this member an invitation to a sitting.
  allowSittingInvites   Boolean    @default(true) @map("allow_sitting_invites")
  /// Look and feel (palette, fonts, sizes) plus display preferences; validated by `normalizePreferences`.
  preferences           Json?
  /// @zod.email("Invalid email address")
  email                 String     @unique
  emailVerified         Boolean    @default(false) @map("email_verified")
  image                 String?
  isAdmin               Boolean    @default(false) @map("is_admin")
  isHidden              Boolean    @default(false) @map("is_hidden")
  status                UserStatus @default(active)

  /// Club activity points; may go negative after moderation.
  xp Int @default(0)
  /// Reading performance points; may go negative after moderation.
  rp Int @default(0)

  /// Telegram user id from Login Widget / bot (string for JSON-safe ids).
  telegramUserId                        String? @unique @map("telegram_user_id")
  telegramUsername                      String? @map("telegram_username")
  /// Daily 14:00 club-time DM nudge while a sitting is in reading (requires Telegram link + bot /start).
  telegramSittingReadingReminderEnabled Boolean @default(true) @map("telegram_sitting_reading_reminder_enabled")

  sessions       Session[]
  accounts       Account[]
  participations Participation[]
  feedbacks      Feedback[]
  votes          PollVote[]
  pollChipGrants PollChipGrant[]

  xpEvents                XPEvent[]
  rpEvents                RPEvent[]
  likes                   Like[]
  comments                Comment[]
  posts                   Post[]
  bookRequests            BookRequest[]
  documents               Document[]
  blockedOpenLibraryWorks BlockedOpenLibraryWork[]
  favorites               Favorite[]
  shelves                 Shelf[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  booksRequested          Book[]                   @relation("BookRequestedBy")
  booksApproved           Book[]                   @relation("BookApprovedBy")
  postAttachmentsAsMember PostAttachment[]         @relation("PostAttachmentMember")
  factsCreated            Fact[]
  factVotes               FactVote[]
  factImpressions         FactImpression[]
  reads                   Read[]
  goals                   Goal[]
  quizSubmissions         QuizSubmission[]
  quizGenerationLogs      QuizGenerationLog[]
  quizQuestionReports     QuizQuestionReport[]
  generatedQuizzes        Quiz[]                   @relation("QuizGeneratedBy")
  profile                 UserProfile?
  achievements            UserAchievement[]

  shelfCollaborations       ShelfCollaborator[] @relation("ShelfCollaboratorUser")
  shelfCollaboratorsInvited ShelfCollaborator[] @relation("ShelfCollaboratorInviter")
  shelfInvitationsReceived  ShelfInvitation[]   @relation("ShelfInvitationInvitee")
  shelfInvitationsSent      ShelfInvitation[]   @relation("ShelfInvitationInviter")
  shelfBooksAdded           ShelfBook[]         @relation("ShelfBookAddedBy")
  shelfBooksUpdated         ShelfBook[]         @relation("ShelfBookUpdatedBy")
  shelfActivities           ShelfActivity[]     @relation("ShelfActivityActor")
  shelfActivityTargets      ShelfActivity[]     @relation("ShelfActivityTarget")

  pollVotes   PostPollVote[]   @relation("PostPollVoter")
  pollBallots PostPollBallot[] @relation("PostPollBallotVoter")

  sittingsCreated            Sitting[]                @relation("SittingCreatedBy")
  readings                   Reading[]
  mentionsReceived           ContentMention[]         @relation("MentionedUser")
  mentionsMade               ContentMention[]         @relation("MentionAuthor")
  bookEditionsCreated        BookEdition[]            @relation("BookEditionCreator")
  bookEditionsVerified       BookEdition[]            @relation("BookEditionVerifier")
  bookRequestUpvotes         BookRequestUpvote[]      @relation("BookRequestUpvoter")
  bookDiscoverAsks           BookDiscoverAsk[]        @relation("BookDiscoverAskUser")
  viewsMade                  View[]                   @relation("ViewViewer")
  viewerSeen                 ViewerSeen[]             @relation("ViewerSeenUser")
  sittingInviteLinksCreated  SittingInviteLink[]      @relation("SittingInviteLinkCreator")
  sittingInviteLinkVisits    SittingInviteLinkVisit[] @relation("SittingInviteLinkVisitor")
  sittingInvitationsReceived SittingInvitation[]      @relation("SittingInvitationInvitee")
  sittingInvitationsSent     SittingInvitation[]      @relation("SittingInvitationInviter")
  pollOptionsAdded           PostPollOption[]         @relation("PostPollOptionAddedBy")
  pollOptionsAsOption        PostPollOption[]         @relation("PostPollOptionUser")

  @@map("user")
}

enum Gender {
  male
  female
  not_specified
}

model UserProfile {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth       DateTime? @map("date_of_birth")
  gender            Gender    @default(not_specified)
  location          String?
  bio               String?   @db.Text
  favoriteGenres    String[]
  favoriteSubgenres String[]

  /// @zod.url("Invalid website URL")
  websiteUrl  String? @map("website_url")
  socialLinks Json?   @map("social_links")

  /// @zod.min(100, "Reading Words Per Minute must be at least 100").max(500, "Reading Words Per Minute must be at most 500")
  wpm Int @default(240) // Reading Words Per Minute

  @@map("user_profile")
}

model Session {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  token     String  @unique
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  /// @zod.min(7, "Password must be at least 7 characters long")
  password              String?

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  identifier String
  value      String

  @@index([identifier])
  @@map("verification")
}
