enum SittingStatus {
  voting // poll is created, participants selects the book they want to read
  reading // voting finished, book is selected, participants start reading
  finished // reading finished, participants submit their feedback
}

model Sitting {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status   SittingStatus @default(voting)
  /// @zod.refine((v) => v > new Date(), { message: "Deadline must be in the future" })
  deadline DateTime

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String @unique

  /// @zod.uuid("Invalid book id")
  selectedBookId String? @map("selected_book_id")
  selectedBook   Book?   @relation("SittingSelectedBook", fields: [selectedBookId], references: [id], onDelete: SetNull)

  participants Participation[]
  poll         Poll?
  rpEvents     RPEvent[]

  @@index([slug])
  @@map("sitting")
}

model Feedback {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.uuid("Invalid user id")
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid book id")
  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// @zod.min(1, "Review must be at least 1 character long").max(500, "Review must be at most 500 characters long")
  review String
  /// @zod.min(0, "Rating must be a non-negative number").max(5, "Rating must be at most 5")
  rating Float

  @@unique([authorId, bookId])
  @@index([bookId])
  @@index([authorId])
  @@index([rating])
  @@map("feedback")
}
