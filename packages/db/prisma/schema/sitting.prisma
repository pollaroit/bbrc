enum SittingStatus {
  voting // poll is created, participants selects the book they want to read
  reading // voting finished, book is selected, participants start reading
  finished // reading finished, participants submit their feedback
}

enum SittingJoinType {
  /// Anyone can join and sees a Join button.
  public
  /// Only people with an invitation link can join.
  unlisted
  /// Only the organisers add people.
  private
}

model Sitting {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status   SittingStatus @default(voting)
  /// @zod.refine((v) => v > new Date(), { message: "Deadline must be in the future" })
  deadline DateTime

  readingStartedAt DateTime? @map("reading_started_at")
  midtermAt        DateTime? @map("midterm_at")

  /// When the midterm check-in, the "24 hours left" notice and the last daily reading reminder went out, so each is sent once.
  midtermNotifiedAt         DateTime? @map("midterm_notified_at")
  deadlineWarningNotifiedAt DateTime? @map("deadline_warning_notified_at")
  readingReminderSentAt     DateTime? @map("reading_reminder_sent_at")

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String @unique

  joinType                SittingJoinType @default(public) @map("join_type")
  /// People can join by themselves while voting is open.
  joinInVoting            Boolean         @default(true) @map("join_in_voting")
  /// People can join by themselves while reading is open...
  joinInReading           Boolean         @default(true) @map("join_in_reading")
  /// ...until this share (10-100) of the reading period has passed.
  joinReadingUntilPercent Int             @default(50) @map("join_reading_until_percent")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("SittingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// @zod.uuid("Invalid book id")
  selectedBookId String? @map("selected_book_id")
  selectedBook   Book?   @relation("SittingSelectedBook", fields: [selectedBookId], references: [id], onDelete: SetNull)

  participants    Participation[]
  inviteLinks     SittingInviteLink[]
  invitations     SittingInvitation[]
  poll            Poll?
  rpEvents        RPEvent[]
  postAttachments PostAttachment[]

  @@index([slug])
  @@map("sitting")
}

model Feedback {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String @unique

  /// @zod.uuid("Invalid user id")
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid book id")
  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// @zod.max(5000, "Review must be at most 5000 characters long")
  review String

  /// Public R2 URL for an optional review image (one, like a post).
  /// @zod.max(2048).nullish()
  imageUrl String? @map("image_url")

  isSpoiler Boolean @default(false) @map("is_spoiler")
  /// @zod.min(0, "Rating must be a non-negative number").max(5, "Rating must be at most 5")
  rating    Float

  likes           Like[]
  comments        Comment[]
  postAttachments PostAttachment[]
  mentions        ContentMention[]

  @@unique([authorId, bookId])
  @@index([bookId])
  @@index([authorId])
  @@index([rating])
  @@index([slug])
  @@map("feedback")
}
