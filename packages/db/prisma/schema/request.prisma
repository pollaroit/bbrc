enum BookRequestStatus {
  pending
  accepted
  rejected
}

model BookRequest {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @zod.import(["import { isOpenLibraryOlid } from '@bbrc/shared'"])
  /// @zod.refine((v) => isOpenLibraryOlid(v), { message: "Invalid Open Library work ID" })
  olid String

  /// Title at request time (from Open Library search); avoids live OL calls when listing.
  /// @zod.min(1, "Title is required").max(500)
  title String? @map("title")

  /// Author names from Open Library search at request time.
  authors String[] @default([]) @map("authors")

  status          BookRequestStatus @default(pending)
  /// @zod.max(200, "Rejection reason must be at most 200 characters long")
  rejectionReason String?
  /// @zod.max(200, "Acceptance notes must be at most 200 characters long")
  acceptanceNotes String?

  @@index([userId])
  @@index([olid])
  @@map("book_request")
}
