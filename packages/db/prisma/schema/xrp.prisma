enum XPEventReason {
  participation // -> Sitting
  feedback // -> Feedback
  vote // -> PollVote
  post // -> Post
  comment // -> Comment
  request // -> BookRequest
}

model XPEvent {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @zod.min(0, "Points must be a non-negative number")
  points Int
  reason XPEventReason

  /// @zod.uuid("Invalid entity id")
  entityId String

  @@index([userId])
  @@map("xp_event")
}

model RPEvent {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  points Int

  /// @zod.uuid("Invalid sitting id")
  sittingId String  @map("sitting_id")
  sitting   Sitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rp_event")
}
