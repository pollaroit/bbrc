model Poll {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  /// @zod.refine((v) => v > new Date(), { message: "Deadline must be in the future" })
  deadline  DateTime

  /// @zod.import(["import { isSlug } from '@bbrc/shared'"])
  /// @zod.min(3, "Slug must be at least 3 characters long").max(60, "Slug must be at most 60 characters long").refine((v) => isSlug(v), { message: "Invalid slug" })
  slug String @unique

  /// @zod.uuid("Invalid sitting id")
  sittingId String  @unique @map("sitting_id")
  sitting   Sitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  /// @zod.min(0, "Min pages must be a non-negative number")
  minPages Int? @map("min_pages")
  /// @zod.min(0, "Max pages must be a non-negative number")
  maxPages Int? @map("max_pages")
  /// @zod.min(0, "Min publish year must be a non-negative number")
  minPublishedIn Int? @map("min_published_in")
  /// @zod.min(0, "Max publish year must be a non-negative number")
  maxPublishedIn Int? @map("max_published_in")
  /// @zod.min(0, "Minimum Open Library rating must be a non-negative number").max(5, "Minimum Open Library rating must be at most 5")
  minOpenLibraryRating Float? @map("min_open_library_rating")
  /// @zod.min(0, "Min reads must be a non-negative number")
  minReads Int? @map("min_reads")
  /// @zod.min(0, "Max reads must be a non-negative number")
  maxReads Int? @map("max_reads")
  /// Wishlist pool: literary origin (ISO 3166-1 alpha-2), same as book.countries.
  filterCountries String[] @default([]) @map("filter_countries")
  /// Wishlist pool: author slugs (see @bbrc/shared isAuthorSlug).
  filterAuthorSlugs String[] @default([]) @map("filter_author_slugs")
  /// @zod.min(3, "Take must be at least 3").max(12, "Take must be at most 12")
  take     Int  @default(10)

  /// @zod.min(1, "Min choices must be at least 1").max(12, "Min choices must be at most 12")
  minChoices Int  @default(1) @map("min_choices")
  /// @zod.min(1, "Max choices must be at least 1").max(12, "Max choices must be at most 12")
  maxChoices Int? @map("max_choices")

  options    PollOption[]
  chipGrants PollChipGrant[]

  @@index([sittingId])
  @@index([slug])
  @@map("poll")
}

model PollOption {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.uuid("Invalid book id")
  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid poll id")
  pollId String @map("poll_id")
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  /// The admin who chose this book directly instead of it being drawn (not shown to members yet).
  /// @zod.uuid("Invalid user id")
  nominatedById String? @map("nominated_by_id")
  nominatedBy   User?   @relation("PollOptionNominator", fields: [nominatedById], references: [id], onDelete: SetNull)

  votes PollVote[]

  @@index([pollId])
  @@index([bookId])
  @@map("poll_option")
}

model PollVote {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid option id")
  optionId String     @map("option_id")
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  /// @zod.min(1, "Points must be at least 1").max(3, "Points must be at most 3")
  points Int @default(1)

  @@unique([userId, optionId])
  @@map("poll_vote")
}

model PollChipGrant {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// @zod.uuid("Invalid poll id")
  pollId String @map("poll_id")
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  canUseGolden Boolean @default(false) @map("can_use_golden")
  canUseSilver Boolean @default(false) @map("can_use_silver")

  @@unique([pollId, userId])
  @@index([pollId])
  @@map("poll_chip_grant")
}
