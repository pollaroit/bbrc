enum Progress {
  not_started
  in_progress
  completed
  dnf
}

model Participation {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid sitting id")
  sittingId String  @map("sitting_id")
  sitting   Sitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  progress Progress @default(not_started)

  @@unique([userId, sittingId])
  @@index([userId])
  @@index([sittingId])
  @@index([progress])
  @@map("participation")
}
