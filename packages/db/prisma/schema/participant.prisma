enum Progress {
  not_started
  in_progress
  completed
  dnf
}

enum ParticipationJoinSource {
  organiser
  button
  link
  invitation
}

model Participation {
  /// @zod.uuid("Invalid UUID")
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @zod.uuid("Invalid user id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @zod.uuid("Invalid sitting id")
  sittingId String  @map("sitting_id")
  sitting   Sitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  progress Progress @default(not_started)

  /// Set when an admin removes someone mid-sitting; row kept for history and XP ledger.
  removedAt DateTime? @map("removed_at")

  /// When the member joined (set again if they are re-added).
  joinedAt   DateTime                @default(now()) @map("joined_at")
  joinSource ParticipationJoinSource @default(organiser) @map("join_source")

  inviteLinkId String?            @map("invite_link_id")
  inviteLink   SittingInviteLink? @relation(fields: [inviteLinkId], references: [id], onDelete: SetNull)

  @@unique([userId, sittingId])
  @@index([userId])
  @@index([sittingId])
  @@index([progress])
  @@map("participation")
}
