{
	"name": "bbrc",
	"version": "1.0.0",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/node": "^26.4.1",
			"varlock": "1.18.0",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"@prisma/client": "^7.10.0",
			"@orpc/server": "^1.15.0",
			"@orpc/client": "^1.15.0",
			"@orpc/openapi": "^1.15.0",
			"@orpc/zod": "^1.15.0",
			"better-auth": "1.7.5",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"typecheck": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"db:push": "turbo run db:push -F @bbrc/db --",
		"db:studio": "turbo run db:studio -F @bbrc/db --",
		"db:generate": "turbo run db:generate -F @bbrc/db --",
		"db:migrate": "turbo run db:migrate -F @bbrc/db --",
		"db:migrate:deploy": "turbo run db:migrate:deploy -F @bbrc/db --",
		"db:seed": "turbo run db:seed -F @bbrc/db --",
		"env:generate": "node ./scripts/guard-varlock-env.mjs && varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
		"postinstall": "node ./scripts/guard-varlock-env.mjs && varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/web && bun run auth:generate",
		"check": "biome check --write .",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@bbrc/config": "workspace:*",
		"@biomejs/biome": "^2.5.12",
		"@types/node": "catalog:",
		"lefthook": "^2.1.12",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2"
	},
	"packageManager": "bun@1.3.14"
}
