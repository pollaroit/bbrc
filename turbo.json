{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"web#build": {
			"dependsOn": ["^build", "@bbrc/db#db:migrate:deploy"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"../../packages/db/prisma/migrations/**",
				"../../packages/db/prisma/schema/**"
			],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": false
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate:deploy": {
			"cache": false,
			"interactive": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:seed": {
			"cache": false,
			"interactive": false
		}
	},
	"globalEnv": [
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"DIRECT_URL",
		"NODE_ENV",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"VERCEL_URL",
		"_VARLOCK_ENV_KEY",
		"CRON_SECRET",
		"CLUB_TIMEZONE",
		"NTFY_BASE_URL",
		"NTFY_TOKEN",
		"NTFY_TOPIC_PREFIX"
	],
	"globalDependencies": [
		".env*",
		"apps/*/.env*",
		"packages/*/.env*",
		"packages/db/prisma/migrations/**",
		"packages/db/prisma/schema/**"
	]
}
