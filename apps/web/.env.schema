# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Optional. Neon direct / unpooled URL for Prisma migrate on deploy (recommended on Vercel).
# If omitted, migrate uses DATABASE_URL with `-pooler` stripped from the host.
# @type=string(minLength=1)
DATABASE_URL_UNPOOLED=

# @type=string(minLength=16)
# Secret for `/api/cron/sittings` (optional Bearer layer; QStash uses signing keys).
CRON_SECRET=

# @type=string(minLength=1)
# Verify `Upstash-Signature` on incoming QStash webhooks.
QSTASH_CURRENT_SIGNING_KEY=

# @type=string(minLength=1)
# Signing key rotation (Upstash QStash).
QSTASH_NEXT_SIGNING_KEY=

# Optional. Upstash QStash REST API (create schedules from scripts; verify uses signing keys above).
# @type=string(minLength=1)
QSTASH_TOKEN=

# Optional. QStash REST base URL (same as Upstash console; not used by cron verify).
# @type=string(minLength=1)
QSTASH_URL=

# @public @type=string(default=Asia/Baku)
# IANA timezone for poll/sitting deadline slots (14:00, 17:00, 20:00, 23:00 club local).
CLUB_TIMEZONE=Asia/Baku

# @type=number(min=0, max=500, default=0)
# How many book/post/author/etc. detail URLs to prerender during `next build` (0 = on-demand ISR only).
ISR_BUILD_WARM_LIMIT=0

# Optional. Cloudflare R2 (S3-compatible). See docs/SPEC.md — uploads disabled when unset.
# @type=string
R2_ACCOUNT_ID=

# @type=string
R2_ACCESS_KEY_ID=

# @type=string
R2_SECRET_ACCESS_KEY=

# @type=string
R2_BUCKET_NAME=

# @public @type=string
# Public bucket URL (e.g. https://pub-xxxx.r2.dev) for Next.js Image and client links.
R2_PUBLIC_BASE_URL=

# Optional. Google Gemini API key for admin fact draft generation (reels). Server-only.
# @type=string(minLength=1)
GEMINI_API_KEY=

# Optional. Ably API key (use the app's Root key; one Ably app for development, another for production).
# Server-only: it mints short-lived tokens for the browser and publishes. Realtime is off while unset.
# @type=string(minLength=1)
ABLY_API_KEY=

# @public @type=string(default=gemini-2.0-flash-lite)
# Gemini model id for fact drafts (see Google AI Studio model list).
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional in development (auth emails log to the server console). Required in production.
# @type=string
RESEND_API_KEY=

# @public @type=string(default=noreply@bbrc.app)
EMAIL_FROM=noreply@bbrc.app
