# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=16)
# Secret for `/api/cron/sittings` (Vercel sends `Authorization: Bearer …`).
CRON_SECRET=

# @public @type=string(default=Asia/Baku)
# IANA timezone for daily poll close and sitting end (20:00 club local).
CLUB_TIMEZONE=Asia/Baku
