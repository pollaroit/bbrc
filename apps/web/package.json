{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3001",
		"build": "bun run --cwd ../.. db:generate && bun run --cwd ../.. db:migrate:deploy && tsc -b ../../packages/api && next build",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"start": "next start",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes"
	},
	"dependencies": {
		"@bbrc/api": "workspace:*",
		"@bbrc/auth": "workspace:*",
		"@bbrc/db": "workspace:*",
		"@bbrc/schemas": "workspace:*",
		"@bbrc/shared": "workspace:*",
		"@bbrc/ui": "workspace:*",
		"@hookform/resolvers": "^5.9.1",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/tanstack-query": "^1.15.0",
		"@orpc/zod": "catalog:",
		"@prisma/client": "catalog:",
		"@swc/helpers": "^0.5.23",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.102.8",
		"@varlock/nextjs-integration": "1.2.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"better-auth": "catalog:",
		"lucide-react": "catalog:",
		"next": "^16.3.4",
		"next-themes": "catalog:",
		"nuqs": "^2.10.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-hook-form": "^7.89.0",
		"recharts": "3.8.0",
		"sonner": "catalog:",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@bbrc/config": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:"
	}
}
